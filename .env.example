# Copia este archivo como .env (y verifica que .env esté en .gitignore)
# Contraseñas: usa caracteres seguros para URL (openssl rand -hex 24)

# Runtime de NestJS: rol con solo DML
DATABASE_URL="postgresql://erp_app:CAMBIAR@192.168.56.12:5432/erp_db?schema=erp"

# CLI de Prisma (migraciones): rol dueño del esquema
MIGRATION_DATABASE_URL="postgresql://erp_owner:CAMBIAR@192.168.56.12:5432/erp_db?schema=erp"
SHADOW_DATABASE_URL="postgresql://erp_owner:CAMBIAR@192.168.56.12:5432/erp_shadow?schema=erp"

# Entorno: development | production | test (Swagger solo fuera de production)
NODE_ENV="development"

# Puerto de la API NestJS
PORT=3000

# Proxies delante de la app: 1 = Nginx (por defecto). 0 = sin proxy (npm run start:dev en la PC)
TRUST_PROXY=1

# JWT: secreto de al menos 32 caracteres (openssl rand -hex 32)
JWT_SECRET="CAMBIAR"
# Duración del token: segundos o con unidad s/m/h/d (ej. 8h)
JWT_EXPIRES_IN="CAMBIAR"

ADMIN_EMAIL="CAMBIAR"

ADMIN_PASSWORD="CAMBIAR"
# Seed (prisma/seed.ts): primer ADMIN, solo si no existe ninguno
ADMIN_EMAIL="admin@empresa.com"
# Mínimo 10 caracteres
ADMIN_PASSWORD="CAMBIAR"

# Almacenamiento de archivos: Garage (compatible con S3) en server-files
# La API S3 de Garage escucha en el puerto 3900
S3_ENDPOINT="http://192.168.56.13:3900"
# Dirección de Garage que usa el NAVEGADOR (URLs firmadas): Nginx en server-web.
# El host:puerto forma parte de la firma: debe ser exactamente al que llega el navegador.
S3_PUBLIC_ENDPOINT="http://192.168.56.10:3900"
# Vigencia de las URLs firmadas en segundos (60 a 604800; por defecto 900)
URL_FIRMADA_SEGUNDOS=900
# Debe coincidir con s3_region de /etc/garage.toml
S3_REGION="garage"
# Clave creada con: garage key create erp-app (el ID empieza con GK)
S3_ACCESS_KEY="CAMBIAR"
S3_SECRET_KEY="CAMBIAR"
S3_BUCKET="erp-archivos"
# Tamaño máximo por archivo en MB (1 a 2047)
ARCHIVO_TAMANO_MAX_MB=100
